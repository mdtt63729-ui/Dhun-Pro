<?xml version="1.0" encoding="utf-8"?>
<!--
    Blank splash icon: the system splash shows no icon, so the animation in the app's own
    overlay is the first thing you see.

    This must NOT be a vector. Older Android versions (7/8) throw
    "no path defined" from VectorDrawable for a vector with no <path>, which crashed the app on
    start on those devices. A plain transparent shape works everywhere.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
