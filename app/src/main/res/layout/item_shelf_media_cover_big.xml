<?xml version="1.0" encoding="utf-8"?><!--
    Echo Music style cover: a single clean SQUARE artwork with rounded corners.
    The old stacked "list backdrop" views (listBg1 / listBg2) are kept so the
    generated view-binding still compiles, but they are permanently hidden.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="?itemCoverSize"
    android:layout_height="?itemCoverSize"
    android:clipToPadding="false">

    <View
        android:id="@+id/listBg2"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:visibility="gone" />

    <View
        android:id="@+id/listBg1"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/rounded_rectangle_cover_echo"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/avatars[2]" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom"
        android:layout_margin="6dp"
        android:alpha="0.66"
        android:background="@drawable/rounded_rectangle_24dp"
        android:backgroundTint="?navBackground"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_queue_music"
        app:tint="?attr/colorOnSurface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/isPlaying"
        style="@style/SmallNowPlayingButton" />

</FrameLayout>
