<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dhun_player_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ripple_60dp"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/arrow_back"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="Dhun"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/heart"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ripple_60dp"
                android:button="@drawable/anim_heart_40dp"
                android:contentDescription="@string/like"
                android:padding="6dp"
                app:buttonTint="@android:color/white" />

            <ImageButton
                android:id="@+id/more"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ripple_60dp"
                android:contentDescription="@string/more"
                android:padding="12dp"
                android:src="@drawable/more_vert"
                android:tint="@android:color/white" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="4dp"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.slider.Slider
                    android:id="@+id/seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:value="0"
                    app:labelBehavior="gone"
                    app:thumbColor="@android:color/white"
                    app:thumbHeight="16dp"
                    app:thumbWidth="16dp"
                    app:trackColorActive="#FFFFFFFF"
                    app:trackColorInactive="#66FFFFFF"
                    app:trackHeight="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/currentTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#D9FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/totalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#BFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:weightSum="3">

                <ImageButton
                    android:id="@+id/previous"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/previous"
                    android:padding="16dp"
                    android:src="@drawable/ic_skip_previous_40dp"
                    android:tint="@android:color/white" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/playPause"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_68dp"
                    android:button="@drawable/anim_play_pause_48dp"
                    android:checked="false"
                    android:contentDescription="@string/play"
                    app:buttonTint="@android:color/white" />

                <ImageButton
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/next"
                    android:padding="16dp"
                    android:src="@drawable/ic_skip_next_40dp"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/volumeDown"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/volume"
                    android:padding="10dp"
                    android:src="@drawable/volume_off"
                    android:tint="@android:color/white" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:value="1"
                    app:labelBehavior="gone"
                    app:thumbColor="@android:color/white"
                    app:thumbHeight="12dp"
                    app:thumbWidth="12dp"
                    app:trackColorActive="#FFFFFFFF"
                    app:trackColorInactive="#55FFFFFF"
                    app:trackHeight="4dp" />

                <ImageButton
                    android:id="@+id/volumeUp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/volume"
                    android:padding="10dp"
                    android:src="@drawable/volume_up"
                    android:tint="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:weightSum="3">

                <ImageButton
                    android:id="@+id/queue"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/up_next"
                    android:padding="14dp"
                    android:src="@drawable/ic_queue_music"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/timer"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/sleep_timer"
                    android:padding="14dp"
                    android:src="@drawable/timer"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/lyrics"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/ripple_60dp"
                    android:contentDescription="@string/lyrics"
                    android:padding="14dp"
                    android:src="@drawable/lyrics"
                    android:tint="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
